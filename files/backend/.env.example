# Copia este archivo como ".env" y llena tus valores reales.
# NUNCA subas el archivo ".env" (con tus contraseñas reales) a GitHub.

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_NAME=libro_mayor
DB_SSL=false

# Genera estos dos con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Deben ser distintos entre sí, y distintos a cualquier cosa que se te ocurra a mano.
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_ADMIN_SECRET=cambia_esto_por_otra_cadena_larga_y_aleatoria_distinta

PORT=4000

# Cuando llegues a la parte de cobro automático (Guía 3):
WOMPI_PRIVATE_KEY_TEST=
WOMPI_EVENTS_SECRET=

# Respaldo en la nube (Cloudflare R2) — OPCIONAL. Mientras esto esté vacío,
# el respaldo automático sigue funcionando, solo que guarda únicamente en
# tu servidor. Ver instrucciones de cómo llenarlo en el README.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

